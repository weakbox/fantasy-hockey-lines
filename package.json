    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/ui": "^4.1.4",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "webextension-polyfill": "^0.12.0",
